NODE_ENV=production
PORT=3000
# Dominio desde el que se usa el sistema (protege las escrituras contra otros sitios)
ALLOWED_ORIGIN=https://erp.justprint.com.ar
SESSION_HOURS=12

# Base MySQL creada en hPanel
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Copias de seguridad (opcional)
# BACKUP_DIR=/home/usuario/backups-justprint
# BACKUP_DIAS=14

# Jornada del SLA (horas hábiles) y carpeta de firmas
# SLA_JORNADA_DESDE=9
# SLA_JORNADA_HASTA=18
# ARCHIVOS_DIR=/home/usuario/storage-justprint

# WhatsApp de soporte que abre el QR de la etiqueta (solo números, con código de país)
# WHATSAPP_SOPORTE=5491135104320

# Alertas por mail (por defecto el canal principal)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=avisos@justprint.com.ar
# SMTP_PASS=
# MAIL_FROM="JustPrint <avisos@justprint.com.ar>"
# URL pública del sistema (para los links dentro de los avisos)
# APP_URL=https://erp.justprint.com.ar

# Alertas por WhatsApp (Meta WhatsApp Cloud API; requiere plantilla aprobada)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=es_AR
